    "db:seed": "tsx src/database/migrate.ts seed"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "eslint-plugin-import": "^2",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3"
  }
}
